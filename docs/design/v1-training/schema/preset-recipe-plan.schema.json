{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Your Singer PresetRecipePlan v1",
  "$comment": "設計契約。現行mainの実装済みAPIではない。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "target",
    "preset",
    "strategy",
    "recipe",
    "dataset",
    "stages",
    "render_profile",
    "required_output",
    "plan_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "target": {
      "enum": [
        "talk",
        "singing"
      ]
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 5
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 5
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 5
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_hash",
        "assessment_hash"
      ],
      "properties": {
        "inventory_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "assessment_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage_id",
          "operation_id",
          "options_ref",
          "options_sha256",
          "initialization"
        ],
        "properties": {
          "stage_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "operation_id": {
            "type": "string",
            "minLength": 5
          },
          "options_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "options_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "initialization": {
            "enum": [
              "fine_tune",
              "from_scratch",
              "not_applicable"
            ]
          }
        }
      }
    },
    "render_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "required_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "version"
      ],
      "properties": {
        "format": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
